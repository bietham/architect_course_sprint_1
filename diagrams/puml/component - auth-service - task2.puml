@startuml
!include <c4/C4_Component.puml>

title Диаграмма компонентов — сервис авторизации — Задание 3


' ===== Внешние клиенты/системы =====
Container(CompanyApp, "Приложения", "Web/Mobile", "Клиентские приложения")
Container(CompanyBackendApiGateway, "API gateway", "Go", "Валидация и маршрутизация запросов")
System_Ext(Mailing, "Внешний email провайдер", "SMTP/REST", "Отправка писем с кодами/ссылками")
ContainerQueue(EventBus, "Event-bus", "Kafka/NATS", "Коммуникация между сервисами")
ContainerDb(CompanyDatabase, "База данных", "PostgreSQL", "Основная БД умного дома")

' ===== Контейнер сервиса авторизации и его компоненты =====
Container_Boundary(AuthorizationService, "Сервис аутентификации/авторизации") {
  Component(AuthzAuthorization, "Authorization Endpoint", "OIDC Authorization Code + PKCE","Логин/SSO, PKCE, consent, MFA-промпт")

  Component(AuthzJWKS, "JWKS Publisher", "RFC 8414 / RFC 7517 (JWK Set), RS256/ES256","Публикация /.well-known и /jwks.json; ротация ключей")

  Component(AuthzMFA, "MFA & Notifications", "WebAuthn/TOTP; SMTP/SMS провайдер","TOTP/SMS/email MFA; письма верификации/алерты безопасности")

  Component(AuthzToken, "Token Endpoint", "OAuth 2.1","authorization_code, refresh_token, client_credentials, token_exchange; выдача access/refresh/id_token; rotation/revoke; introspect")

  ComponentDb(AuthzUserCreds, "User & Credentials Store", "PostgreSQL","Учётные записи, статусы; password hash, passkeys/WebAuthn, соц-аккаунты")

  ComponentDb(AuthzSession, "Session/Refresh Manager", "Redis","Хранение и ротация refresh, deny-list, TTL, device sessions")
}

' ===== Связи клиентов с компонентами сервиса =====
Rel(CompanyApp, AuthzAuthorization, "Клиентские запросы к authorization-service", "HTTPS")
Rel(CompanyBackendApiGateway, AuthzJWKS, "Обновление ключей (.well-known → /jwks.json)", "HTTPS")

' ===== Внутренние связи компонентов сервиса =====
Rel(AuthzAuthorization, AuthzUserCreds, "Проверка учётки/статуса", "in-process + SQL")
Rel(AuthzAuthorization, AuthzMFA, "Шаг MFA/верификации email", "in-process")

Rel(AuthzToken, AuthzUserCreds, "Вычитывание пользователя", "in-process + SQL")
Rel(AuthzToken, AuthzSession, "[...]", "in-process")

Rel(AuthzJWKS, AuthzToken, "Доступ к приватным ключам/ротация (KMS/HSM), key rollover", "in-process")

' Публикация событий вовне
Rel(AuthzAuthorization, EventBus, "События регистрации/смены email (UserRegistered, EmailChanged)", "Kafka/NATS")
Rel(AuthzToken, EventBus, "События входа/ревокации (UserLoggedIn, TokenRevoked)", "Kafka/NATS")

' Доступ к внешним системам/БД
Rel(AuthzUserCreds, CompanyDatabase, "Адресация запросов к хранилищу", "TCP/IP")
Rel(AuthzMFA, Mailing, "Отправка кода/ссылки", "SMTP/REST")

' Дополнительная связь клиента через шлюз (опционально)
Rel(CompanyApp, CompanyBackendApiGateway, "[...]", "HTTPS")

@enduml
